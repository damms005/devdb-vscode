{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevDb Configuration",
  "description": "Configuration file for DevDb VS Code extension",
  "type": "array",
  "items": {
    "type": "object",
    "oneOf": [
      {
        "title": "SQLite Configuration",
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "sqlite"
            ],
            "description": "Database type - SQLite"
          },
          "path": {
            "type": "string",
            "description": "Path to SQLite database file"
          }
        }
      },
      {
        "title": "DuckDB Configuration",
        "required": [
          "type",
          "path"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "duckdb"
            ],
            "description": "Database type - DuckDB"
          },
          "path": {
            "type": "string",
            "description": "Path to DuckDB database file"
          },
          "readOnly": {
            "type": "boolean",
            "description": "Open the DuckDB file read-only. Set to false to allow writes.",
            "default": true
          }
        },
        "description": "DuckDB database file (DevDb Pro). Opened read-only unless readOnly is false."
      },
      {
        "title": "MySQL/MariaDB Configuration",
        "required": [
          "type",
          "name",
          "username",
          "password",
          "database"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Optional name for this connection"
          },
          "type": {
            "type": "string",
            "enum": [
              "mysql",
              "mariadb"
            ],
            "description": "Database type - MySQL or MariaDB"
          },
          "host": {
            "type": "string",
            "description": "Database host",
            "default": "localhost"
          },
          "port": {
            "type": "number",
            "description": "Database port",
            "default": 3306
          },
          "username": {
            "type": "string",
            "description": "Database username"
          },
          "password": {
            "type": "string",
            "description": "Database password"
          },
          "database": {
            "type": "string",
            "description": "Database name"
          }
        }
      },
      {
        "title": "PostgreSQL Configuration",
        "required": [
          "type",
          "name",
          "username",
          "password",
          "database"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Optional name for this connection"
          },
          "type": {
            "type": "string",
            "enum": [
              "postgres"
            ],
            "description": "Database type - PostgreSQL"
          },
          "host": {
            "type": "string",
            "description": "Database host",
            "default": "localhost"
          },
          "port": {
            "type": "number",
            "description": "Database port",
            "default": 5432
          },
          "username": {
            "type": "string",
            "description": "Database username"
          },
          "password": {
            "type": "string",
            "description": "Database password"
          },
          "database": {
            "type": "string",
            "description": "Database name"
          }
        }
      },
      {
        "title": "Microsoft SQL Server Configuration",
        "required": [
          "type",
          "name",
          "username",
          "password",
          "database"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Optional name for this connection"
          },
          "type": {
            "type": "string",
            "enum": [
              "mssql"
            ],
            "description": "Database type - Microsoft SQL Server"
          },
          "host": {
            "type": "string",
            "description": "Database host",
            "default": "localhost"
          },
          "port": {
            "type": "number",
            "description": "Database port",
            "default": 1433
          },
          "username": {
            "type": "string",
            "description": "Database username"
          },
          "password": {
            "type": "string",
            "description": "Database password"
          },
          "database": {
            "type": "string",
            "description": "Database name"
          },
          "options": {
            "type": "object",
            "description": "Driver-specific options for MSSQL, e.g. trustServerCertificate",
            "additionalProperties": true
          }
        }
      },
      {
        "title": "Redis / Valkey Configuration",
        "description": "Redis or Valkey key-value store (DevDb Pro)",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name for this connection"
          },
          "type": {
            "type": "string",
            "enum": [
              "redis"
            ],
            "description": "Database type - Redis or Valkey"
          },
          "connectionString": {
            "type": "string",
            "description": "Connection URL, e.g. redis://user:pass@host:6379/0 or rediss:// for TLS. When set, the host, port and credential fields are ignored."
          },
          "host": {
            "type": "string",
            "description": "Server host",
            "default": "localhost"
          },
          "port": {
            "type": "number",
            "description": "Server port",
            "default": 6379
          },
          "username": {
            "type": "string",
            "description": "ACL username"
          },
          "password": {
            "type": "string",
            "description": "Password"
          },
          "database": {
            "type": "number",
            "description": "Database index",
            "default": 0
          },
          "keyPrefix": {
            "type": "string",
            "description": "Only show keys that start with this prefix"
          },
          "tls": {
            "type": "boolean",
            "description": "Connect over TLS",
            "default": false
          }
        }
      },
      {
        "title": "ClickHouse Configuration",
        "description": "ClickHouse OLAP database over HTTP(S) (DevDb Pro)",
        "required": [
          "type",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name for this connection"
          },
          "type": {
            "type": "string",
            "enum": [
              "clickhouse"
            ],
            "description": "Database type - ClickHouse"
          },
          "host": {
            "type": "string",
            "description": "Server host",
            "default": "localhost"
          },
          "port": {
            "type": "number",
            "description": "HTTP(S) port",
            "default": 8123
          },
          "protocol": {
            "type": "string",
            "enum": [
              "http",
              "https"
            ],
            "description": "HTTP protocol. Defaults to http for localhost, https for any other host or port 8443/9440."
          },
          "username": {
            "type": "string",
            "description": "Username",
            "default": "default"
          },
          "password": {
            "type": "string",
            "description": "Password"
          },
          "database": {
            "type": "string",
            "description": "Database name",
            "default": "default"
          }
        }
      }
    ]
  }
}
