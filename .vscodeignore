# Ignore everything by default
*
**

# Include only necessary files
!package.json
!LICENSE*

# Include compiled files (esbuild bundles everything into dist/)
!dist/**/*.js
!dist/**/*.node
!dist/**/*.wasm
!ui-shell/dist/**

# Include icons
!resources/devdb-128x128.png
!resources/devdb.png

# Include snippets and schemas
!snippets/*
!schemas/*

# @vscode/sqlite3: uses node-gyp-build with complex dynamic requires that can't be bundled by esbuild
!node_modules/@vscode/sqlite3/**

# @duckdb/node-api: externalized in esbuild.js. The per-platform binding package is
# selected in CI by .github/scripts/prepare-native-deps.js (only one ships per VSIX).
!node_modules/@duckdb/node-api/**
!node_modules/@duckdb/node-bindings/**
!node_modules/@duckdb/node-bindings-*/**
!node_modules/detect-libc/**

# Never ship local test profiles
.vscode-test/**
