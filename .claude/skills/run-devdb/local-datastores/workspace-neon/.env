# Neon provider auto-detect (needs /etc/hosts: 127.0.0.1 ep-local-devdb-123456.us-east-2.aws.neon.tech
# and VS Code started with NODE_EXTRA_CA_CERTS=<stack>/certs/ca.crt). Without the hosts entry this hits REAL Neon DNS.
DATABASE_URL="postgresql://neondb_owner:npg_localpass@ep-local-devdb-123456.us-east-2.aws.neon.tech:5432/neondb?sslmode=require"
